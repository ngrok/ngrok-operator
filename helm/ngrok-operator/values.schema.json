        "ngrok": {
            "type": "object",
            "properties": {
                "description": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "Description attached to the ngrok API resources the operator creates. Default: `The official ngrok Kubernetes Operator.`",
                    "default": null
                },
                "region": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "ngrok region to use. Unset means the account default",
                    "default": null
                },
                "serverAddr": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "Address of the ngrok server to use for tunnels. Unset means the ngrok default",
                    "default": null
                },
                "apiURL": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "Base URL for the ngrok API. Unset means the ngrok default",
                    "default": null
                },
                "rootCAs": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "Root CAs to use: `trusted` for the ngrok CA, `host` for the host's CA bundle. Default: `trusted`",
                    "default": null
                },
                "clusterDomain": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "Cluster domain used when resolving in-cluster service addresses. Default: `svc.cluster.local`",
                    "default": null
