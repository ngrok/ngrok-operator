{
    "title": "Chart Values",
    "type": "object",
    "properties": {
        "nameOverride": {
            "type": "string",
            "description": "Partially override the generated resource names",
            "default": ""
        },
        "fullnameOverride": {
            "type": "string",
            "description": "Fully override the generated resource names",
            "default": ""
        },
        "commonLabels": {
            "type": "object",
            "description": "Labels added to all resources created by this chart",
            "default": {}
        },
        "commonAnnotations": {
            "type": "object",
            "description": "Annotations added to all resources created by this chart",
            "default": {}
        },
        "image": {
            "type": "object",
            "properties": {
                "registry": {
                    "type": "string",
                    "description": "The ngrok operator image registry.",
                    "default": "docker.io"
                },
                "repository": {
                    "type": "string",
                    "description": "The ngrok operator image repository.",
                    "default": "ngrok/ngrok-operator"
                },
                "tag": {
                    "type": "string",
                    "description": "The ngrok operator image tag. Defaults to the chart's appVersion if not specified",
                    "default": ""
                },
                "pullPolicy": {
                    "type": "string",
                    "description": "The ngrok operator image pull policy.",
                    "default": "IfNotPresent"
                },
                "pullSecrets": {
                    "type": "array",
                    "description": "An array of imagePullSecrets to be used when pulling the image.",
                    "default": [],
                    "items": {}
                }
            },
            "additionalProperties": false
        },
        "defaults": {
            "type": "object",
            "properties": {
                "podAnnotations": {
                    "type": "object",
                    "description": "Pod annotations for every component",
                    "default": {}
                },
                "podLabels": {
                    "type": "object",
                    "description": "Pod labels for every component",
                    "default": {}
                },
                "nodeSelector": {
                    "type": "object",
                    "description": "Node labels for pod assignment",
                    "default": {}
                },
                "tolerations": {
                    "type": "array",
                    "description": "Tolerations for every component's pods",
                    "default": [],
                    "items": {}
                },
                "affinity": {
                    "type": "object",
                    "description": "Affinity rules for every component's pods. Overrides the presets below when set.",
                    "default": {}
                },
                "podAffinityPreset": {
                    "type": "string",
                    "description": "Pod affinity preset. Ignored if `affinity` is set. Allowed values: \"\" (none), \"soft\" or \"hard\"",
                    "default": ""
